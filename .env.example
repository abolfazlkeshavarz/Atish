# ──────────────── Atish configuration ────────────────
# `make env` copies this to .env and generates every secret for you.

# Public HTTPS URL users reach the app on (Telegram requires HTTPS). Local testing: http://localhost:8080
PUBLIC_URL=http://localhost:8080
APP_DOMAIN=
DOMAIN=                             # used by: docker compose --profile tls up -d  (built-in Caddy HTTPS)
LETSENCRYPT_EMAIL=

# Where the web container listens. With host nginx (make ssl) keep it on loopback.
WEB_BIND=0.0.0.0
WEB_PORT=8080
VERSION=latest

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
ENCRYPTION_KEY=                     # base64 of 32 random bytes — encrypts phone numbers. Never rotate casually.

# Telegram bot (create with @BotFather, then set the Mini App / menu button URL to PUBLIC_URL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Admin panel: https://<PUBLIC_URL>/admin  (password login) and/or Telegram admins
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                     # >= 12 chars; leave empty to disable password login
ADMIN_TELEGRAM_IDS=                 # comma-separated Telegram user ids that become admins on login

# Payments (optional). Telegram Stars needs only the bot token.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # webhook URL: <PUBLIC_URL>/api/billing/webhook/stripe

# Local development only — NEVER enable in production
DEV_AUTH=false
APP_ENV=production
